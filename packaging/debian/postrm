#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
fi

if [ "$1" = purge ]; then
    # dpkg already removed centinela.toml; keep anything you added to checks.d and centinela.d.
    # /etc/sec/notify.env is not ours and is never touched.
    rm -rf /var/lib/centinela
    rm -f /etc/centinela/centinela.d/10-wizard.toml
    rmdir /etc/centinela/checks.d /etc/centinela/centinela.d /etc/centinela 2>/dev/null || true
fi

exit 0
