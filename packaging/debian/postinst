#!/bin/sh
set -e

if [ "$1" = configure ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    # the account for the optional restricted profile (centinela --print restricted); no login, nothing runs as it by default
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers centinela.conf 2>/dev/null || true
    fi
    if [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.1.0; then
        cat <<'EOF'

centinela: upgraded from a version before 1.1. Two things may need your attention:
  - the services check no longer assumes fail2ban/nginx/docker/ssh: see what changes for you with
      sudo centinela migrate
  - commands in your own checks that could change the machine are now refused (and reported as a warning)
See "Upgrading from 1.0" in the README.

EOF
    fi
    if [ -z "$2" ]; then
        cat <<'EOF'

centinela is installed but not running yet. Next steps:
  0. Let the wizard look at this server and write the config for you:   sudo centinela setup
  1. Put the Telegram secrets in /etc/sec/notify.env (directory 700, file 600, root):
       TELEGRAM_BOT_TOKEN=...
       TELEGRAM_CHAT_ID=...
  2. Review /etc/centinela/centinela.toml (disable modules this host does not need).
  3. Check it:   sudo centinela --dry-run     and     sudo centinela --test
  4. Start it:   sudo systemctl enable --now centinela-daily.timer centinela-weekly.timer

EOF
    fi
fi

exit 0
